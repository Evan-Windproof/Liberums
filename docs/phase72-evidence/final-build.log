mkdir -p build/arch/x86/
gcc -m32 -march=i686 -mno-mmx -mno-sse -mno-sse2 -msoft-float -ffreestanding -fno-pic -fno-pie -g3 -c arch/x86/keyboard_irq.S -o build/arch/x86/keyboard_irq.o
ld -m elf_i386 -nostdlib --build-id=none -T arch/x86/linker.ld \
	-Map=build/liberums.map  build/kernel/main.o build/kernel/serial.o build/kernel/panic.o build/arch/x86/idt.o build/kernel/memory_map.o build/kernel/boot_info.o build/kernel/physical_pages.o build/arch/x86/paging.o build/kernel/selftest.o build/arch/x86/gdt.o build/kernel/domain.o build/kernel/syscall.o build/kernel/capability.o build/kernel/resource.o build/tests/resource_pressure.o build/kernel/elf_loader.o build/kernel/external.o build/arch/x86/user_space.o build/tests/elf_pressure.o build/arch/x86/pic.o build/arch/x86/pit.o build/kernel/tick.o build/kernel/timer.o build/kernel/scheduler.o build/kernel/revoke.o build/tests/phase6_runtime.o build/kernel/vga.o build/kernel/vga_device.o build/tests/phase71_runtime.o build/arch/x86/ps2.o build/kernel/keyboard.o build/tests/phase72_runtime.o build/arch/x86/keyboard_irq.o build/arch/x86/irq.o build/arch/x86/boot.o build/arch/x86/isr.o build/arch/x86/test_faults.o build/arch/x86/user_context.o build/arch/x86/user_images.o -o build/liberums.elf
